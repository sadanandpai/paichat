# LLM provider switch (NEW).
#   claude-cli            -> run the agent on Claude via the local `claude` CLI.
#                            No API key needed (rides on the CLI's own auth), but
#                            it runs ungrounded (no RAG/lookup tools) and calls
#                            are remote + billed per token.
#   anything else / unset -> run on Gemini with the full grounded toolset.
#                            Requires GOOGLE_API_KEY + the Weaviate/Upstash backends below.
# Added so the bot isn't locked to Gemini; flip this one line to change engines.
LLM_PROVIDER=claude-cli

# Optional: pin the model the claude CLI uses (defaults to the CLI's session model).
# CLAUDE_CLI_MODEL=claude-opus-4-8

# --- Gemini path + grounded tools (required unless LLM_PROVIDER=claude-cli) ---
GOOGLE_API_KEY=your-google-api-key
ADMIN_SECRET=your-admin-secret

WEAVIATE_URL=https://your-cluster.weaviate.cloud
WEAVIATE_API_KEY=your-weaviate-api-key

UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
